{
  "name": "stickman-studio-engine",
  "version": "3.0.0",
  "description": "Procedural stickman cartoon engine: one story JSON file becomes a narrated, captioned, sound-designed vertical MP4. No AI image or video generation.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "remotion": "remotion studio src/index.ts",
    "studio": "tsx scripts/studio.ts",
    "doctor": "python scripts/doctor.py",
    "validate": "tsx scripts/validate.ts",
    "make": "tsx scripts/make.ts",
    "assets": "python scripts/gen_audio_assets.py",
    "still": "tsx scripts/stills.ts",
    "locations": "tsx scripts/locations.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test.ts",
    "qa:sync": "tsx scripts/qa_sync.ts",
    "qa:geometry": "tsx scripts/qa_geometry.ts",
    "qa:audio": "python scripts/qa_audio.py",
    "qa:video": "python scripts/qa_video.py",
    "qa:timing": "python scripts/qa_timing.py",
    "qa:visual": "python scripts/qa_visual_report.py",
    "qa": "npm run typecheck && npm test && npx tsx scripts/qa_sync.ts stories/why-phone-gets-hot.json && npx tsx scripts/qa_geometry.ts stories/why-phone-gets-hot.json"
  },
  "dependencies": {
    "@react-three/fiber": "9.4.0",
    "@remotion/bundler": "4.0.541",
    "@remotion/cli": "4.0.541",
    "@remotion/google-fonts": "4.0.541",
    "@remotion/renderer": "4.0.541",
    "@remotion/three": "4.0.541",
    "@remotion/transitions": "4.0.541",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.541",
    "three": "0.181.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/three": "0.181.0",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
}
