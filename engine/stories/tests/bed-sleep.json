      "actors": [{ "id": "man", "action": "sleepOn", "on": "bed", "expression": "sleepy", "underBlanket": true }],
      "props": [{ "type": "bed", "x": 0.5, "z": 0.35, "color": "#4f78c9" }],
      "fx": ["zzz"]
    },
    {
      "say": "The phone alarm rings, but he does not move.",
      "bg": "bedroom", "time": "night", "framing": "medium", "camera": "pushIn",
      "actors": [{ "id": "man", "action": "sleepOn", "on": "bed", "expression": "sleepy", "underBlanket": true }],
      "props": [
        { "type": "bed", "x": 0.5, "z": 0.35, "color": "#4f78c9" },
        { "type": "phone", "x": 0.28, "z": 0.5, "y": 210, "glow": true }
      ],
      "sfx": ["alarm"], "transition": "cut"
    },
    {
      "say": "Then he sits up on the edge of the bed.",
      "bg": "bedroom", "time": "night", "framing": "medium", "camera": "pushIn",
      "actors": [{ "id": "man", "action": "sitOn", "on": "bed", "expression": "sleepy", "facing": "left" }],
