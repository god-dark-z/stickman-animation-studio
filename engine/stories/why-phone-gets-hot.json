      "actors": [{ "id": "sam", "x": 0.5, "z": 0.5, "pose": "wave", "expression": "happy", "enter": "pop" }],
      "fx": ["sparkle"], "transition": "iris"
    },
    {
      "say": "He drives into a canyon to take one quick call.",
      "location": "desert", "framing": "wide", "camera": "panRight", "focus": "sam",
      "actors": [{ "id": "sam", "x": 0.35, "z": 0.5, "pose": "walk", "expression": "neutral", "moveTo": 0.55 }],
      "props": [{ "type": "car", "x": 0.2, "z": 0.2, "scale": 1 }],
      "fx": ["dust"]
