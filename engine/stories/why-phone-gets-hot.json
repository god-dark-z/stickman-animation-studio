      "fx": ["sweat"]
    },
    {
      "say": "That backwards detail is real, and it has a name.",
      "bg": "bedroom", "framing": "medium", "camera": "drift",
      "actors": [{ "id": "sam", "x": 0.45, "z": 0.5, "pose": "think", "expression": "suspicious" }],
      "transition": "dissolve"
